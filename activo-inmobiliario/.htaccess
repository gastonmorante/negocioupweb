Options -Indexes
DirectoryIndex index.html
AddType video/mp4 .mp4

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /activo-inmobiliario/

  # Force HTTPS safely behind Hostinger CDN / reverse proxies
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback (never rewrite missing static assets to HTML)
  RewriteCond %{REQUEST_URI} !\.(js|css|png|jpe?g|gif|svg|ico|webp|mp4|woff2?)$ [NC]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self' https:; script-src 'self' https://app.cloudpano.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://formsubmit.co https://app.cloudpano.com https://*.cloudpano.com; frame-src 'self' https://app.cloudpano.com https://*.cloudpano.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://formsubmit.co; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), payment=(), usb=()"
</IfModule>
